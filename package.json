{
  "name": "inventory-system",
  "version": "1.0.0",
  "description": "Local Inventory Management System",
  "main": "electron/main.js",
  "bin": "preview_server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node preview_server.js",
    "desktop:start": "electron .",
    "sync:data": "node scripts/sync-data-json.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "node scripts/smoke-check.js && node --test",
    "test:smoke": "node scripts/smoke-check.js",
    "test:cases": "node --test",
    "coverage": "c8 --check-coverage --lines 75 --statements 75 --functions 80 --branches 60 --exclude=case/** --exclude=lib/** --reporter=text --reporter=html node --test",
    "ci:check": "npm run lint && npm run typecheck && npm test && npm run coverage",
    "build": "npm run build:desktop",
    "build:server": "pkg . --out-path dist",
    "build:desktop": "electron-builder --win nsis",
    "build:desktop:dir": "electron-builder --win dir"
  },
  "pkg": {
    "assets": [
      "index.html",
      "assets/**/*",
      "css/**/*",
      "js/**/*",
      "lib/**/*",
      "data/**/*"
    ],
    "targets": [
      "node22-win-x64"
    ]
  },
  "build": {
    "appId": "com.happy01.inventory",
    "productName": "仓库库存管理系统",
    "asar": true,
    "directories": {
      "output": "desktop-dist"
    },
    "files": [
      "electron/**/*",
      "preview_server.js",
      "server/**/*",
      "index.html",
      "assets/**/*",
      "css/**/*",
      "js/**/*",
      "lib/**/*",
      "data/*.json",
      "package.json"
    ],
    "win": {
      "icon": "assets/app-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Happy01Inventory-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "仓库库存管理系统",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "@yao-pkg/pkg": "^6.22.0",
    "c8": "^11.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3"
  }
}
