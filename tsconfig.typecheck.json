{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "preview_server.js",
    "electron/**/*.js",
    "scripts/**/*.js",
    "case/**/*.js",
    "js/**/*.js",
    "types/**/*.d.ts",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", "lib", "data", "assets", ".npm-cache"]
}
